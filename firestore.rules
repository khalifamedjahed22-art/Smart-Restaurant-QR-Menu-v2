rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function owner(restaurantId) {
      return signedIn() &&
        get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerUid == request.auth.uid;
    }

    function activeRestaurant(restaurantId) {
      let r = get(/databases/$(database)/documents/restaurants/$(restaurantId)).data;
      return r.subscription != null &&
        (r.subscription.status == null || r.subscription.status == 'active') &&
        r.subscription.frozen != true;
    }

    match /restaurants/{restaurantId} {
      allow read: if admin() || owner(restaurantId) || activeRestaurant(restaurantId);

      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid;

      allow update: if admin() || (owner(restaurantId) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'whatsapp', 'requireTableNumber', 'categories', 'themeId', 'updatedAt'
        ]));

      allow delete: if admin();

      match /items/{itemId} {
        allow read: if admin() || owner(restaurantId) || activeRestaurant(restaurantId);
        allow create: if admin() || owner(restaurantId);
        allow update: if admin() || owner(restaurantId);
        allow delete: if admin() || owner(restaurantId);
      }

      match /analytics/{dayId} {
        allow read: if admin() || owner(restaurantId);
        allow write: if false;
      }
    }

    match /system/{docId} {
      allow read: if docId == 'config' || admin();
      allow write: if admin();
    }

    match /system/admin {
      allow read: if admin();
    }
  }
}
